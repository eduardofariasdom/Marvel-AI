# Copie para .env e preencha. O .env NAO vai para o Git.
GROQ_API_KEY=
MODELO_IA=groq:openai/gpt-oss-120b

# Service account do Firebase. Escolha UMA das duas:
#  (a) caminho de arquivo - no Render use um Secret File em /etc/secrets/
# FIREBASE_SERVICE_ACCOUNT_FILE=/etc/secrets/serviceAccount.json
#  (b) o JSON inteiro, numa linha so (use: python formatar_env.py)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Chave gratuita em https://comicvine.gamespot.com/api/
# Sem ela o catalogo usa so o Firestore.
COMICVINE_API_KEY=

# Vazio e o correto: app Android nao manda header Origin.
ALLOWED_ORIGINS=
